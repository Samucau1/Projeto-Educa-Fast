SECRET_KEY=
DATA_ENCRYPTION_KEY=
LGPD_CONTROLADOR=EducaFast
LGPD_CONTATO=
# Producao: APP_ENV=production, COOKIE_SECURE=1, DB_SSL_CA=/run/tls/ca.crt
APP_ENV=development
COOKIE_SECURE=0
TRUSTED_HOSTS=localhost,127.0.0.1

JWT_EXPIRATION_HOURS=8
UPLOAD_FOLDER=uploads

# Credenciais do banco, troque pelos valores corretos do seu ambiente
DB_PORT=3306
DB_NAME=app_web
DB_USER=app_user
DB_PASSWORD=troque-por-uma-senha-forte

# Senha do usuário root do MySQL (apenas administração)
MYSQL_ROOT_PASSWORD=troque-por-outra-senha-forte
